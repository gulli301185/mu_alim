{
  "name": "mu-alim",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:setup": "prisma generate && prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed:qa": "tsx server/src/seed-qa.ts",
    "db:seed:qa-views": "tsx server/src/seed-qa-telegram-views.ts",
    "db:seed:courses": "tsx server/src/seed-courses.ts",
    "db:seed:tests": "tsx server/src/seed-final-tests.ts",
    "db:seed:images": "tsx server/src/seed-site-images.ts",
    "db:renumber:qa": "tsx server/src/seed-qa.ts",
    "db:import:qa": "node scripts/parse-telegram-qa.mjs",
    "db:import:telegram-html": "tsx server/src/import-telegram-html.ts",
    "db:import:aqida": "tsx server/src/import-aqida-lessons.ts",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "npx --yes concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server"
  },
  "devDependencies": {
    "prisma": "^6.14.0",
    "tsx": "^4.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "react-router-dom": "^7.18.3"
  }
}
