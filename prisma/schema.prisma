// Mu Alim — Islamic Education Platform
// Database schema based on technical specification

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum CourseType {
  free
  paid

  @@map("course_type")
}

enum EnrollmentStatus {
  active
  completed
  cancelled
  expired

  @@map("enrollment_status")
}

enum PaymentStatus {
  pending
  success
  failed
  refunded

  @@map("payment_status")
}

enum TestType {
  lesson
  final

  @@map("test_type")
}

enum ReviewStatus {
  pending
  approved
  rejected

  @@map("review_status")
}

enum QaArticleType {
  text
  video

  @@map("qa_article_type")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  role         UserRole  @default(user)
  isActive     Boolean   @default(true) @map("is_active")
  isVerified   Boolean   @default(false) @map("is_verified")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  profile        UserProfile?
  enrollments    Enrollment[]
  payments       Payment[]
  lessonProgress LessonProgress[]
  courseProgress CourseProgress[]
  testAttempts   TestAttempt[]
  reviews        Review[]
  certificates   Certificate[]
  qaArticles     QaArticle[]
  passwordResets PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ─── Courses ─────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(180)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  courses Course[]

  @@map("categories")
}

model Instructor {
  id              String   @id @default(uuid()) @db.Uuid
  fullName        String   @map("full_name") @db.VarChar(255)
  photo           String?  @db.VarChar(500)
  education       String?  @db.Text
  qualification   String?  @db.Text
  experience      String?  @db.Text
  specialization  String?  @db.Text
  biography       String?  @db.Text
  teachingMethod  String?  @map("teaching_method") @db.Text
  achievements    String?  @db.Text
  socialLinks     Json?    @map("social_links") @db.JsonB
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  courses CourseInstructor[]

  @@map("instructors")
}

model Course {
  id               String     @id @default(uuid()) @db.Uuid
  categoryId       String     @map("category_id") @db.Uuid
  title            String     @db.VarChar(255)
  slug             String     @unique @db.VarChar(280)
  shortDescription String?    @map("short_description") @db.VarChar(500)
  description      String     @db.Text
  coverImage       String?    @map("cover_image") @db.VarChar(500)
  courseType       CourseType @map("course_type")
  price            Decimal    @default(0) @db.Decimal(12, 2)
  currency         String     @default("KGS") @db.VarChar(10)
  level            String?    @db.VarChar(30)
  durationMinutes  Int?       @map("duration_minutes")
  passingScore     Decimal    @default(80) @map("passing_score") @db.Decimal(5, 2)
  isPopular        Boolean    @default(false) @map("is_popular")
  isPublished      Boolean    @default(false) @map("is_published")
  publishedAt      DateTime?  @map("published_at") @db.Timestamptz
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  category       Category           @relation(fields: [categoryId], references: [id])
  instructors    CourseInstructor[]
  lessons        Lesson[]
  enrollments    Enrollment[]
  payments       Payment[]
  courseProgress CourseProgress[]
  tests          Test[]
  questions      Question[]
  reviews        Review[]
  certificates   Certificate[]

  @@index([categoryId])
  @@index([isPublished, isPopular])
  @@map("courses")
}

model CourseInstructor {
  courseId     String  @map("course_id") @db.Uuid
  instructorId String  @map("instructor_id") @db.Uuid
  isPrimary    Boolean @default(false) @map("is_primary")

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([courseId, instructorId])
  @@map("course_instructors")
}

model Lesson {
  id              String   @id @default(uuid()) @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  title           String   @db.VarChar(255)
  description     String?  @db.Text
  youtubeUrl      String   @map("youtube_url") @db.VarChar(500)
  youtubeVideoId  String   @map("youtube_video_id") @db.VarChar(50)
  durationSeconds Int?     @map("duration_seconds")
  lessonOrder     Int      @map("lesson_order")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course              Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgress      LessonProgress[]
  tests               Test[]
  lastInCourseProgress CourseProgress[] @relation("LastLesson")

  @@unique([courseId, lessonOrder])
  @@index([courseId])
  @@map("lessons")
}

// ─── Access & Payments ───────────────────────────────────────────────────────

model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  courseId    String           @map("course_id") @db.Uuid
  status      EnrollmentStatus
  enrolledAt  DateTime         @map("enrolled_at") @db.Timestamptz
  completedAt DateTime?        @map("completed_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  courseId         String        @map("course_id") @db.Uuid
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @db.VarChar(10)
  paymentMethod    String        @map("payment_method") @db.VarChar(50)
  transactionId    String        @unique @map("transaction_id") @db.VarChar(255)
  status           PaymentStatus
  providerResponse Json?         @map("provider_response") @db.JsonB
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("payments")
}

// ─── Learning Progress ───────────────────────────────────────────────────────

model LessonProgress {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  lessonId             String    @map("lesson_id") @db.Uuid
  videoProgressSeconds Int       @default(0) @map("video_progress_seconds")
  isVideoCompleted     Boolean   @default(false) @map("is_video_completed")
  isLessonCompleted    Boolean   @default(false) @map("is_lesson_completed")
  completedAt          DateTime? @map("completed_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model CourseProgress {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  progressPercent Decimal   @default(0) @map("progress_percent") @db.Decimal(5, 2)
  lastLessonId    String?   @map("last_lesson_id") @db.Uuid
  isCompleted     Boolean   @default(false) @map("is_completed")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lastLesson Lesson? @relation("LastLesson", fields: [lastLessonId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("course_progress")
}

// ─── Testing ─────────────────────────────────────────────────────────────────

model Test {
  id             String   @id @default(uuid()) @db.Uuid
  courseId       String   @map("course_id") @db.Uuid
  lessonId       String?  @map("lesson_id") @db.Uuid
  title          String   @db.VarChar(255)
  testType       TestType @map("test_type")
  questionsCount Int      @map("questions_count")
  passingScore   Decimal  @default(80) @map("passing_score") @db.Decimal(5, 2)
  maxAttempts    Int?     @map("max_attempts")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson       Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  testQuestions TestQuestion[]
  attempts     TestAttempt[]

  @@index([courseId])
  @@index([lessonId])
  @@map("tests")
}

// Table #13 omitted in TZ — inferred from question_options & test_questions relations
model Question {
  id           String   @id @default(uuid()) @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  questionText String   @map("question_text") @db.Text
  explanation  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  options       QuestionOption[]
  testQuestions TestQuestion[]
  testAnswers   TestAnswer[]

  @@index([courseId])
  @@map("questions")
}

model QuestionOption {
  id          String  @id @default(uuid()) @db.Uuid
  questionId  String  @map("question_id") @db.Uuid
  optionText  String  @map("option_text") @db.Text
  isCorrect   Boolean @default(false) @map("is_correct")
  optionOrder Int     @map("option_order")

  question      Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedInAnswers TestAnswer[]

  @@index([questionId])
  @@map("question_options")
}

model TestQuestion {
  testId        String @map("test_id") @db.Uuid
  questionId    String @map("question_id") @db.Uuid
  questionOrder Int?   @map("question_order")

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@map("test_questions")
}

model TestAttempt {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  testId          String    @map("test_id") @db.Uuid
  attemptNumber   Int       @map("attempt_number")
  totalQuestions  Int       @map("total_questions")
  correctAnswers  Int       @default(0) @map("correct_answers")
  score           Decimal   @db.Decimal(5, 2)
  passed          Boolean   @default(false)
  startedAt       DateTime  @map("started_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  test    Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers TestAnswer[]

  @@index([userId, testId])
  @@map("test_attempts")
}

model TestAnswer {
  id               String   @id @default(uuid()) @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  selectedOptionId String   @map("selected_option_id") @db.Uuid
  isCorrect        Boolean  @map("is_correct")
  answeredAt       DateTime @map("answered_at") @db.Timestamptz

  attempt        TestAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id])
  selectedOption QuestionOption @relation(fields: [selectedOptionId], references: [id])

  @@index([attemptId])
  @@map("test_answers")
}

// ─── Reviews & Certificates ──────────────────────────────────────────────────

model Review {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  courseId  String       @map("course_id") @db.Uuid
  rating    Int          @db.SmallInt
  comment   String?      @db.Text
  status    ReviewStatus
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@map("reviews")
}

model Certificate {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  courseId          String   @map("course_id") @db.Uuid
  certificateNumber String   @unique @map("certificate_number") @db.VarChar(100)
  verificationCode  String   @unique @default(uuid()) @map("verification_code") @db.Uuid
  pdfFile           String   @map("pdf_file") @db.VarChar(500)
  issuedAt          DateTime @map("issued_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@map("certificates")
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Hadith {
  id          String   @id @default(uuid()) @db.Uuid
  text        String   @db.Text
  source      String   @db.VarChar(255)
  explanation String?  @db.Text
  displayDate DateTime @unique @map("display_date") @db.Date
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("hadiths")
}

model FaqCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(180)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  faqs Faq[]

  @@map("faq_categories")
}

model Faq {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  question    String   @db.Text
  answer      String   @db.Text
  source      String?  @db.VarChar(500)
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("faqs")
}

model QaArticle {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique @db.VarChar(280)
  questionNumber Int?          @map("question_number")
  question       String        @db.Text
  answer         String        @db.Text
  excerpt        String?       @db.VarChar(500)
  tags           String[]      @default([])
  type           QaArticleType @default(text)
  telegramViews  Int           @default(0) @map("telegram_views")
  siteViews      Int           @default(0) @map("site_views")
  views          Int           @default(0)
  isPublished    Boolean       @default(true) @map("is_published")
  publishedAt    DateTime      @map("published_at") @db.Timestamptz
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isPublished, publishedAt(sort: Desc)])
  @@index([isPublished, questionNumber(sort: Asc)])
  @@index([views(sort: Desc)])
  @@map("qa_articles")
}

// ─── Prayer Times ──────────────────────────────────────────────────────────────

model PrayerLocation {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @db.VarChar(150)
  country   String  @db.VarChar(100)
  region    String? @db.VarChar(100)
  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)
  isActive  Boolean @default(true) @map("is_active")

  @@map("prayer_locations")
}
