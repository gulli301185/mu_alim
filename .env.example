DATABASE_URL="postgresql://postgres:password@localhost:5432/mu_alim?schema=public"

# Redis cache (optional). Without it the API reads straight from PostgreSQL.
REDIS_URL="redis://localhost:6379"

# API server
PORT=3001
# Extra allowed origins, comma-separated. https://mualim.kg, https://www.mualim.kg and http://localhost:5173 are always allowed.
CLIENT_ORIGIN=""
JWT_SECRET="change-this-secret-in-production"

# Admin (seed script)
ADMIN_EMAIL="admin@mualim.academy"
ADMIN_PASSWORD="admin123456"

# Каттоо жана «забыли пароль» коду почтага кетет (aero.kg сыяктуу).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-mailbox@gmail.com"
SMTP_PASS="gmail-app-password"
SMTP_FROM="Mu Alim <your-mailbox@gmail.com>"

# Optional SMS (почта иштебесе)
SMS_LOGIN=""
SMS_PASSWORD=""
SMS_SENDER="MuAlim"

